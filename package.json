{
  "name": "ccmpg",
  "version": "1.0.1",
  "description": "Claude Code Multi-Provider Gateway — Anthropic-compatible proxy that routes by model name",
  "keywords": [
    "claude-code",
    "anthropic",
    "proxy",
    "gateway",
    "llm"
  ],
  "homepage": "https://github.com/themaxaboy/claude-code-multi-provider-gateway#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themaxaboy/claude-code-multi-provider-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/themaxaboy/claude-code-multi-provider-gateway/issues"
  },
  "author": "themaxaboy",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ccmpg": "bin/ccmpg.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch bin/ccmpg.js start --verbose",
    "start": "node bin/ccmpg.js start",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "install:global": "npm install --global .",
    "uninstall:global": "npm uninstall --global ccmpg",
    "link": "npm link",
    "unlink": "npm unlink --global ccmpg",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.2.1",
    "yaml": "^2.6.1"
  }
}
